{
  "name": "ccetl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "productName": "CcETL",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:quiet": "vite --host 0.0.0.0 --port 3000 --logLevel warn",
    "dev:debug": "vite --host 0.0.0.0 --port 3000 --debug",
    "build": "vite build",
    "build:analyze": "vue-tsc && vite build --mode analyze",
    "preview": "vite preview",
    "lint:eslint": "eslint \"src/**/*.{vue,ts,js}\" --fix",
    "lint:prettier": "prettier --write \"**/*.{js,ts,json,css,less,scss,vue,html,md}\"",
    "clean": "rm -rf node_modules/.vite && rm -rf dist",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder --publish=never"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@logicflow/core": "^2.0.13",
    "@logicflow/extension": "^2.0.18",
    "@monaco-editor/loader": "^1.5.0",
    "@vueuse/core": "^13.5.0",
    "axios": "^1.5.1",
    "codemirror": "^5",
    "codemirror-editor-vue3": "^2.8.0",
    "element-plus": "^2.4.1",
    "monaco-editor": "^0.52.2",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.0",
    "vue": "^3.3.4",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/codemirror": "^5.60.15",
    "@types/node": "^20.8.7",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "cssnano": "^7.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.51.0",
    "eslint-plugin-vue": "^9.17.0",
    "less": "^4.2.0",
    "prettier": "^3.0.3",
    "sass": "^1.89.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vue-tsc": "^1.8.5",
    "wait-on": "^8.0.3"
  }
}
