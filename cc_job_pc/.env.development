# 开发环境配置
# 设置开发服务器配置
VITE_HOST=0.0.0.0
VITE_PORT=3000

# 热更新配置
VITE_HMR_TIMEOUT=3000
VITE_HMR_OVERLAY=false

# 日志级别
VITE_LOG_LEVEL=warn

# 开发模式标识
VITE_DEV_MODE=true

# API 相关配置（如果需要）
VITE_API_BASE_URL=http://localhost:8989

# 是否开启 mock 数据
VITE_USE_MOCK=false

# 是否开启源码映射
VITE_SOURCEMAP=true

# 是否开启包分析
VITE_BUNDLE_ANALYZER=false
